# Build artifacts (mirrors AYPhysics/.gitignore pattern)
build/
out/
*.obj
*.o
*.exe
*.dll
*.lib
*.pdb
# Generated *.cmake script files are excluded by the catch-all pattern
# below, but AY2D keeps its own `cmake/*.cmake` helpers as tracked
# source (the bgfx-leak guard script, etc.). Re-include them explicitly.
*.cmake
!CMakeLists.txt
!**/CMakeLists.txt
!cmake/*.cmake
!**/cmake/*.cmake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# IDE
.vs/
.vscode/
*.user
*.suo
*.ncb
*.opensdf
*.sdf

# Coverage / Profiling
*.gcda
*.gcno
*.profraw
*.profdata

# OS
.DS_Store
Thumbs.db

# Crash / Editor scratch
*.dmp
*.stackdump
